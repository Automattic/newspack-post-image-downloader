{
  "name": "automattic/newspack-post-image-downloader",
  "description": "Downloads all Post images hosted externally, or imports them from local files.",
  "license": "GPL-2.0-or-later",
  "autoload": {
    "classmap": [
      "src/",
      "tests/"
    ]
  },
  "repositories": [
    {
        "type": "vcs",
        "url": "https://github.com/Automattic/newspack-migration-tools.git"
    }
  ],
  "require": {
    "composer/installers": "^2.0",
    "brainmaestro/composer-git-hooks": "^2.6",
    "symfony/dom-crawler": "^5.2",
    "symfony/css-selector": "^5.2",
    "automattic/newspack-migration-tools": "dev-trunk"
  },
  "require-dev": {
    "automattic/vipwpcs": "^3.0",
    "wp-coding-standards/wpcs": "^3.0",
    "dealerdirect/phpcodesniffer-composer-installer": "^0.7.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1"
  },
  "archive": {
    "exclude": [
      "release/*",
      "bin/*",
      "tests/*",
      "phpunit*",
      ".phpunit*",
      "phpcs*",
      ".phpcs*",
      ".git*",
      ".git/*",
      ".distignore",
      ".DS_Store",
      ".env*",
      ".idea",
      "*.log*",
      "release",
      "composer.json",
      "composer.lock",
      "composer.lock_old"
    ]
  },
  "scripts": {
    "release": [
      "composer install --no-dev --optimize-autoloader",
      "composer archive --format=zip --dir=release --file=newspack-post-image-downloader"
    ]
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
